/* BASIC RESET */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {
    font-family: "Segoe UI", Arial, sans-serif;

    color: #17233f;

    min-height: 100vh;

    background-color: #f7fcff;

    background-image:
        radial-gradient(
            circle,
            rgba(74, 163, 255, 0.16) 2px,
            transparent 3px
        );

    background-size: 26px 26px;
}


/* HERO / HEADER */

.hero {
    position: relative;

    overflow: hidden;

    padding: 40px 5% 100px;

    background:
        linear-gradient(
            135deg,
            #ffffff 0%,
            #dfeef7 55%,
            #d8efff 100%
        );

    border-bottom: 1px solid #c7e4ff;
}


.hero::before {
    content: "";

    position: absolute;

    width: 280px;
    height: 280px;

    top: -130px;
    left: -90px;

    border-radius: 50%;

    background: rgba(74, 163, 255, 0.10);
}


.hero::after {
    content: "";

    position: absolute;

    width: 330px;
    height: 330px;

    right: -120px;
    bottom: -190px;

    border-radius: 50%;

    background: rgba(74, 163, 255, 0.12);
}


/* HERO CONTENT */

.hero-content {
    position: relative;

    z-index: 2;

    max-width: 1200px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 60px;
}


/* LOGO */

.logo-container {
    width: 250px;

    min-width: 250px;

    height: 250px;

    display: flex;

    align-items: center;

    justify-content: center;

    position: relative;
}


.logo-container::before {
    content: "";

    position: absolute;

    width: 235px;

    height: 235px;

    border-radius: 50%;

    border: 2px dashed rgba(22, 119, 210, 0.30);
}


.team-logo {
    width: 220px;

    height: 220px;

    object-fit: contain;

    display: block;

    position: relative;

    z-index: 2;

    transition: transform 0.3s ease;
}


.team-logo:hover {
    transform: scale(1.04) rotate(1deg);
}


/* HEADER TEXT */

.header-text {
    max-width: 700px;

    text-align: left;
}


.small-title {
    color: #1677d2;

    font-size: 12px;

    font-weight: 800;

    letter-spacing: 5px;

    margin-bottom: 8px;
}


.header-text h1 {
    color: #073b8c;

    font-size: clamp(58px, 7vw, 86px);

    line-height: 0.95;

    letter-spacing: 3px;

    font-weight: 900;
}


.header-text h3 {
    color: #1677d2;

    font-size: 16px;

    font-weight: 800;

    letter-spacing: 2px;

    margin-top: 14px;
}


.header-line {
    width: 100px;

    height: 4px;

    margin: 18px 0;

    border-radius: 10px;

    background:
        linear-gradient(
            90deg,
            #1677d2,
            #4aa3ff
        );
}


.team-description {
    max-width: 680px;

    font-size: 14px;

    line-height: 1.7;

    color: #263654;

    font-weight: bold;
}


/* TEAM HEADING */

.team-heading {
    width: 92%;

    max-width: 1250px;

    margin: 45px auto 25px;

    text-align: center;
}


.team-heading span {
    color: #1677d2;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 4px;
}


.team-heading div {
    width: 55px;

    height: 3px;

    background: #4aa3ff;

    border-radius: 10px;

    margin: 10px auto 0;
}


/* TEAM MEMBERS */

.team-container {
    position: relative;

    z-index: 3;

    width: 92%;

    max-width: 1250px;

    margin: 0 auto 70px;

    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}


/* MEMBER CARD */

.member-card {
    min-height: 390px;

    background: rgba(255, 255, 255, 0.98);

    border: 1px solid #c7e4ff;

    border-radius: 24px;

    padding: 24px;

    display: grid;

    grid-template-columns: 105px 1fr;

    gap: 20px;

    box-shadow:
        0 12px 35px rgba(28, 104, 175, 0.10);

    position: relative;

    overflow: hidden;

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
}


.member-card:hover {
    transform: translateY(-8px);

    border-color: #8bc5ff;

    box-shadow:
        0 20px 45px rgba(28, 104, 175, 0.17);
}


.member-card::before {
    content: "";

    position: absolute;

    width: 90px;

    height: 90px;

    right: -35px;

    top: -35px;

    border-radius: 50%;

    background: rgba(74, 163, 255, 0.12);
}


.member-card::after {
    content: "";

    position: absolute;

    top: 0;

    left: 25px;

    right: 25px;

    height: 4px;

    border-radius: 0 0 10px 10px;

    background:
        linear-gradient(
            90deg,
            #1677d2,
            #65b2ff
        );
}


